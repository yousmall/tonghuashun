DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# 同花顺问财 SkillHub/OpenAPI（只读；不要提交真实密钥）
IWENCAI_API_KEY=replace-with-your-read-only-api-key
IWENCAI_BASE_URL=https://openapi.iwencai.com
# 可选：供应商按 Skill 单独签发的密钥；为空时沿用 IWENCAI_API_KEY
IWENCAI_MARKET_API_KEY=
IWENCAI_FINANCE_API_KEY=
IWENCAI_MACRO_API_KEY=
IWENCAI_FUND_API_KEY=
IWENCAI_SELECTOR_API_KEY=
IWENCAI_ANNOUNCEMENT_API_KEY=
IWENCAI_NEWS_API_KEY=
IWENCAI_REPORT_API_KEY=
IWENCAI_BASICINFO_API_KEY=
IWENCAI_INDUSTRY_API_KEY=
IWENCAI_BUSINESS_API_KEY=
IWENCAI_MANAGEMENT_API_KEY=
IWENCAI_INSRESEARCH_API_KEY=
IWENCAI_SECTOR_SELECTOR_API_KEY=
IWENCAI_EVENT_API_KEY=
# 单个研究数据能力的总预算，包含排队/重试；超时只使该能力失败
WENCE_DATA_CALL_TIMEOUT_SECONDS=30
IWENCAI_PUBLIC_RECOVERY_ENABLED=1

# MySQL 用户、登录与对话历史（数据库需预先创建，数据表会自动创建）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wence
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=wence_zhitou

# 至少 32 位随机字符串，用于签发登录令牌；不要提交真实值
WENCE_AUTH_SECRET=replace-with-at-least-32-random-characters
WENCE_AUTH_TOKEN_TTL_HOURS=24

# 微信开放平台「网站应用」扫码登录；回调地址须是已审核域名下的 HTTPS URL
WENCE_WECHAT_APP_ID=
WENCE_WECHAT_APP_SECRET=
WENCE_WECHAT_CALLBACK_URL=https://your-domain.example/api/v1/auth/wechat/callback

# 登录会话线程池：最多 100 个并发登录，600 秒无操作后回收
WENCE_SESSION_MAX_WORKERS=100
WENCE_SESSION_IDLE_SECONDS=600

# LLM 调用预算：共享并发限制；总超时包括排队和重试
WENCE_LLM_TIMEOUT_SECONDS=30
WENCE_LLM_MAX_RETRIES=1
WENCE_LLM_MAX_CONCURRENCY=5
WENCE_LLM_MAX_OUTPUT_TOKENS=2000
WENCE_LLM_MAX_INPUT_CHARS=60000

# auto：DeepSeek V4 关闭思考以避免耗尽输出预算；其他模型省略供应商扩展参数
WENCE_LLM_THINKING_MODE=auto

# 精确模型输入复用：仅同一已认证账号，内存保存；设为 0 可关闭
WENCE_LLM_CACHE_TTL_SECONDS=120
WENCE_RESEARCH_MAX_CONCURRENCY=8
WENCE_RESEARCH_QUEUE_SECONDS=1
# 一次自动补取的总时间预算：取数、PDF 原文和证据评估共同使用，默认 45 秒
WENCE_RECOVERY_TIMEOUT_SECONDS=45
# 实际合同单价，USD/百万 token；留空时成本明确为未知
WENCE_LLM_INPUT_USD_PER_MILLION=
WENCE_LLM_OUTPUT_USD_PER_MILLION=
# 同一主机多进程共享公开资料；空字符串关闭，默认 .tmp_flow/public_research_cache.sqlite3
# WENCE_RESEARCH_CACHE_PATH=D:/tonghuashun/tonghuashun/.tmp_flow/public_research_cache.sqlite3
# 同机共享登录租约；空字符串关闭，默认 .tmp_flow/login_sessions.sqlite3
# WENCE_SESSION_STORE_PATH=D:/tonghuashun/tonghuashun/.tmp_flow/login_sessions.sqlite3
